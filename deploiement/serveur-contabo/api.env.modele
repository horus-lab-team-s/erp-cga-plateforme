# Les secrets de l'API et de l'ordonnanceur. Copier en `api.env` (chmod 600) sur le serveur,
# JAMAIS dans un dépôt. La production refuse de démarrer si l'un des réglages obligatoires
# manque ou est dangereux (voir `Configuration` dans le dépôt du serveur).

# 32 octets en base64 : chiffre les clés du second facteur et scelle les liens. Générée par
# `deployer.sh` à la première montée. ⚠️ La perdre rend illisibles les seconds facteurs.
CGA_CLE_CHIFFREMENT=

# Les courriels partent par Brevo, de l'une de deux façons :
# 1. la CLÉ D'API (`xkeysib-…`), celle du compte Brevo de Gathe Finance sur ce serveur, reprise
#    par `reprendre-cles.sh` (BREVO_API_KEY=CGA_BREVO_CLE_API). Posée, elle passe avant le SMTP.
CGA_BREVO_CLE_API=
# 2. ou le relais SMTP (Paramètres › SMTP et API › SMTP) : l'identifiant et la CLÉ SMTP
#    (`xsmtpsib-…`), qui n'est pas la clé d'API. Port 587, STARTTLS.
CGA_SMTP_HOTE=smtp-relay.brevo.com
CGA_SMTP_PORT=587
CGA_SMTP_CHIFFREMENT=true
CGA_SMTP_UTILISATEUR=
CGA_SMTP_MOT_DE_PASSE=
# En ligne AVANT que le relais soit prêt : `true` démarre sans lui, et RETIENT les courriels
# (aucun lien d'activation ni de mot de passe oublié ne part). À retirer dès le relais posé.
CGA_COURRIELS_DIFFERES=false
# Une adresse d'un domaine vérifié chez Brevo : cga-brcgroup.com doit y être déclaré, et ses
# entrées SPF et DKIM posées dans la zone DNS (O2Switch). Sans cela, Brevo refuse ou le courriel
# part en indésirable.
CGA_COURRIEL_EXPEDITEUR=CGA Broad Range <noreply@cga-brcgroup.com>
CGA_COURRIEL_REPONDRE_A=contact@cga-brcgroup.com

# Tara Money : vides, le paiement mobile money est refusé avec un message, et le guichet du
# cabinet reste ouvert. L'adresse de rappel (api./souscription/notification/tara) part avec
# chaque demande de paiement : rien à déclarer chez Tara.
CGA_TARA_CLE_API=
CGA_TARA_IDENTIFIANT_MARCHAND=

# Les agents comptables (lecture des factures et OCR, relecture de la balance et de la DSF,
# contrats, recrutement) : facultatifs. Sans clé, rien ne quitte le serveur et tout se fait à la main.
# Deux fournisseurs possibles ; CGA_IA_FOURNISSEUR choisit (openai | anthropic), vide = celui dont
# la clé est posée. Le fournisseur nommé sans sa clé coupe les agents (aucune bascule silencieuse).
CGA_IA_FOURNISSEUR=openai
# ChatGPT (OpenAI) : clé sur https://platform.openai.com/api-keys
CGA_OPENAI_CLE_API=
CGA_OPENAI_MODELE=gpt-5.5
# Claude (Anthropic)
CGA_ANTHROPIC_CLE_API=
